# Tra nghĩa trong app (POST /api/lookup). Sao chép thành .env.local rồi điền giá trị thật.
ANTHROPIC_API_KEY=
# Trần chi phí (USD) cho cả đời kho Upstash; mặc định 9 nếu để trống hoặc không hợp lệ.
LOOKUP_BUDGET_USD=
# Upstash Redis (REST) — Vercel KV đặt các biến KV_*; nếu dùng Upstash trực tiếp thì đặt UPSTASH_*.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
